# Authentication limits (export through the host/container environment).
# Optional workaround for a verified Npgsql LoadBackendTypes timeout; default false.
# Only enable when application queries do not need custom PostgreSQL types.
Database__SkipTypeLoading=false
# ASP.NET Core reads environment variables; this file is a reference, not a dotenv loader.
# Request budgets are per IP per instance; password-change send/confirm share one budget.
Registration__MaxRequests=5
Registration__RequestWindowSeconds=60
# Password counters are in Redis per normalized email/purpose and expire from the first attempt.
Registration__MaxPasswordAttempts=5
Registration__PasswordAttemptWindowMinutes=10
# Request/password/OTP thresholds accept 1..5; all time windows must be positive.
Registration__MaxVerificationAttempts=5
Registration__OtpTtlMinutes=10
Registration__ResendCooldownSeconds=60
