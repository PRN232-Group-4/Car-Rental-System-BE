<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VehicleRental.WebApi\VehicleRental.WebApi.csproj" />
    <ProjectReference Include="..\..\src\VehicleRental.Infrastructure\VehicleRental.Infrastructure.csproj" />
  </ItemGroup>

  <!-- PostgresFixture applies docs/db/Init.sql plus every db/migrations/*.sql at runtime. -->
  <ItemGroup>
    <None Include="..\..\docs\db\Init.sql" Link="docs\db\Init.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\db\migrations\*.sql" Link="db\migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Shared with VehicleRental.Application.Tests: both compile the same source file instead of a fifth project. -->
  <ItemGroup>
    <Compile Include="..\Shared\WorkflowMemory.cs" Link="Shared\WorkflowMemory.cs" />
  </ItemGroup>

</Project>
