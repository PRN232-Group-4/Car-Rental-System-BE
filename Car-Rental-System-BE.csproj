    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Car_Rental_System_BE</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.5" />
