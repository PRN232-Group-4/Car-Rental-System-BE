    <ProjectReference Include="src\VehicleRental.Application\VehicleRental.Application.csproj" />
    <ProjectReference Include="src\VehicleRental.Infrastructure\VehicleRental.Infrastructure.csproj" />
  </ItemGroup>

</Project>
